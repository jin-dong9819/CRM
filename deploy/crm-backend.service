[Unit]
Description=CRM Backend
After=network.target mysql.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/crm/app
Environment=TZ=Asia/Shanghai
ExecStart=/usr/bin/java -Xms256m -Xmx512m -jar /opt/crm/app/crm-backend.jar --spring.profiles.active=prod --spring.config.additional-location=file:/etc/crm/
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
